 void OSystem_Emscripten::delayMillis(uint msecs) {
+	EM_ASM({ if (Module.audioTrace && Module.audioTrace.length < 50000) Module.audioTrace.push([performance.now(), 3, $0]); }, msecs);
 	static uint32 lastSleep = 0;
 	if (msecs == 0 && getMillis() - lastSleep < 20) {
 		return;
 	}
+	// Local A/B experiment only: maintain the requested wall-clock wait,
+	// but allow the cooperative audio timer to refill during long waits.
+	static const bool serviceDuringWait = EM_ASM_INT({
+		return new URLSearchParams(location.search).get('service_timers') === '1';
+	});
+	if (serviceDuringWait) {
+		const uint32 started = getMillis();
+		uint32 elapsed = 0;
+		do {
+			SDL_Delay(MIN<uint32>(10, msecs > elapsed ? msecs - elapsed : 0));
+			((EmscriptenTimerManager *)_timerManager)->checkTimers();
+			elapsed = getMillis() - started;
+		} while (elapsed < msecs);
+		lastSleep = getMillis();
+		return;
+	}
 #ifdef ENABLE_EVENTRECORDER
 	// The recorder suppresses real delays for deterministic timing, but on
 	// Emscripten SDL_Delay is the asyncify suspend point — never yielding
